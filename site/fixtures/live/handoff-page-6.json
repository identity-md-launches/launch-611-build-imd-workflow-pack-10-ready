il the end; the beneficiary claims vested tokens; irrevocable.","types":["contracts","sites"],"audits":[],"release":{"status":"completed","failure":null},"research":[],"versions":[],"contracts":[{"id":"57b612f0-cd80-4945-8744-18f0c57bbc0a","kind":"evm_project","token":{"name":"Cliffhanger","symbol":"CLIF"},"status":"live","chainId":11155111,"artifacts":[{"name":"CliffhangerToken","role":"token","txHash":"0x31be1c3db01f8be30b3b325d592099c68cacb621f9b0a190522eacac28d02c90","address":"0xe8ae910bbabf4a8ea92b954dab364d106c34a224"},{"name":"MerkleDistributor","role":"distributor","txHash":"0x31be1c3db01f8be30b3b325d592099c68cacb621f9b0a190522eacac28d02c90","address":"0x3c8b47a403c2b65167e3af4cbd39c0e8d0f9c143"},{"name":"VestingCliff","role":"other","txHash":"0x31be1c3db01f8be30b3b325d592099c68cacb621f9b0a190522eacac28d02c90","address":"0xc7f85726186b975ffa7bce9bf63135398953d17b"}],"createdAt":"2026-09-21T15:43:47.857+00:00","updatedAt":"2026-09-21T15:44:28.88+00:00","launchNumber":92,"parkedReason":null,"sourceCommit":"339db0c6f8060e9fa0b10dc3c8d1ad0672c85c5c","sourceRepoUrl":"https://github.com/Identity-md/launch-92-workflow-contract-stage-context"}],"publishedAt":"2026-09-21T16:52:02.196+00:00"},{"id":"workflow:b41fdc9b-e5bf-4bae-b3a9-070eb80327ef","code":[],"media":[],"sites":[{"id":"57f26104-8e1d-44d9-ac8f-2a79d841bb5c","cid":"bafybeiei37zeiylhqejpuyzhrr3eosqw7lpsi7l5k7ukmkyt4m3ujtr5pa","jobId":"7c92af1d-48e7-4df1-baf5-2c9f38552d4f","label":"cdnc","status":"named","txHash":"0x25148236cc7525afcd7fee7d49205b07d1d957349c746d13b06f434e1732d166","ensName":"cdnc.site.identitymd.eth","failure":null,"namedAt":"2026-09-21T16:50:05.341+00:00","repoUrl":"https://github.com/Identity-md/launch-105-workflow-frontend-stage-context","pinnedAt":"2026-09-21T16:45:29.688+00:00","createdAt":"2026-09-21T15:57:26.228+00:00","supersededBy":null}],"title":"Build Cadence: a simple, elegant protocol on Sepolia with its own token CDNC, the SubscriptionRegistry contract, a full Foundry test suit